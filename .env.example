# Скопируйте этот файл в .env и заполните нужные значения.
# Приложение работает и без них: в демо-режиме данные хранятся на телефоне,
# а фильмы берутся из встроенного демо-каталога.
# После изменения .env перезапустите `npx expo start`.

# --- Каталог фильмов и сериалов (TMDB) ------------------------------------
# Ключ: https://www.themoviedb.org/settings/api
# Подойдёт и «API Key», и «API Read Access Token».
EXPO_PUBLIC_TMDB_KEY=

# --- Аккаунты, друзья, лента (Supabase) -----------------------------------
# Project Settings → API (Data API): Project URL и publishable / anon key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Для публикации в App Store -------------------------------------------
# Ссылка на опубликованную политику конфиденциальности (шаблон: docs/legal/privacy-policy.md)
EXPO_PUBLIC_PRIVACY_URL=
# Почта поддержки (показывается в настройках приложения)
EXPO_PUBLIC_SUPPORT_EMAIL=

# --- Необязательное -------------------------------------------------------
# Свой прокси для TMDB, если api.themoviedb.org недоступен в вашей стране:
# EXPO_PUBLIC_TMDB_API_BASE=https://your-proxy.example.com/3
# EXPO_PUBLIC_TMDB_IMAGE_BASE=https://your-proxy.example.com/t/p
# Принудительный демо-режим (для скриншотов и тестов):
# EXPO_PUBLIC_DEMO=1
